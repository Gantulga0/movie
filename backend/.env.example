# ---- Database (Supabase PostgreSQL) ----
# Pooler (transaction mode, :6543) — runtime queries. pgbouncer=true required.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session mode (:5432) — migrations/introspection.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Server ----
PORT=4000
NODE_ENV="development"
APP_NAME="Infinite"

# ---- CORS (frontend origin; comma-separated for multiple) ----
CORS_ORIGIN="http://localhost:3000"

# ---- JWT ----
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ---- Admin seed (prisma db seed) ----
ADMIN_PHONE="99000000"
ADMIN_EMAIL="admin@movie.local"
ADMIN_PASSWORD="Admin123!"

# ---- SMTP (OTP emails). Empty = dev mode, codes are logged to console ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Infinite <no-reply@example.com>"

# ---- SMS (OTP texts). "console" logs codes; "messagepro" uses messagepro.mn ----
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_FROM=""

# ---- QPay merchant API. Empty username = MOCK mode (dev mock-pay endpoint) ----
QPAY_BASE_URL="https://merchant.qpay.mn"
QPAY_USERNAME=""
QPAY_PASSWORD=""
QPAY_INVOICE_CODE=""
# Public URL QPay calls after the customer pays, e.g. https://api.example.com/api/billing/callback
QPAY_CALLBACK_URL=""

# ---- Uploads ----
# R2 хоосон үед файлууд локал диск рүү хадгалагдана (default:
# ../frontend/public/uploads — Next /uploads/... замаар шууд үйлчилнэ).
# LOCAL_UPLOAD_DIR=""

# ---- Cloudflare R2 (S3 compatible) ----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public base URL for the bucket (custom domain or r2.dev). Used to build returned file URLs.
R2_PUBLIC_URL=""
