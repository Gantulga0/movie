# ---- Database (Supabase PostgreSQL) ----
# Pooler (transaction mode, :6543) — runtime queries. pgbouncer=true required.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session mode (:5432) — migrations/introspection.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Server ----
PORT=4000
NODE_ENV="development"
APP_NAME="Infinite"

# ---- CORS (frontend origin; comma-separated for multiple) ----
CORS_ORIGIN="http://localhost:3000"

# ---- JWT ----
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ---- Admin seed (prisma db seed) ----
ADMIN_PHONE="99000000"
ADMIN_EMAIL="admin@movie.local"
ADMIN_PASSWORD="Admin123!"

# ---- verify.mn (Mongolia MO-SMS phone verification). REQUIRED for phone verify ----
# Secret key from the verify.mn dashboard. Empty = phone verification disabled
# (verifyPhone() fails loudly). Never commit a real key.
VERIFY_MN_API_KEY=""
VERIFY_MN_BASE_URL="https://api.verify.mn"
# Optional public https base verify.mn calls back on when the SMS lands, e.g.
# "https://api.example.com/api". Leave EMPTY to use polling only (recommended
# for local dev) — do NOT register a fake URL, verify.mn retries failed callbacks.
VERIFY_MN_CALLBACK_BASE=""
# Optional: milliseconds between status polls (default 3000).
# VERIFY_MN_POLL_INTERVAL_MS="3000"
# verify.mn's load-balanced callback source IPs (comma-separated). Requests to
# the callback route from any other IP get 403. Set empty to disable (local dev).
VERIFY_MN_CALLBACK_IP="3.34.8.248,13.124.219.192"

# ---- wire.mn gateway. Empty WIRE_API_KEY = MOCK mode. ----
WIRE_BASE_URL="https://api.wire.mn/v1"
# Secret key from the wire.mn dashboard → API keys (sk_live_...)
WIRE_API_KEY=""
# Webhook signing secret (whsec_...), shown once when you create the endpoint
WIRE_WEBHOOK_SECRET=""
# Public web origin the payment returns to after confirm (defaults to CORS_ORIGIN)
APP_WEB_URL="http://localhost:3000"
# Allowed webhook source IP(s), comma-separated. Default is wire.mn's IP.
# Set empty to disable the check (e.g. when testing webhooks locally).
# WIRE_WEBHOOK_IP="65.109.117.186"

# ---- Uploads ----
# R2 хоосон үед файлууд локал диск рүү хадгалагдана (default:
# ../frontend/public/uploads — Next /uploads/... замаар шууд үйлчилнэ).
# LOCAL_UPLOAD_DIR=""

# ---- Cloudflare R2 (S3 compatible) ----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public base URL for the bucket (custom domain or r2.dev). Used to build returned file URLs.
R2_PUBLIC_URL=""
