generator client {
  provider        = "prisma-client-js"
  // Single-SQL JOIN loading — the remote (Supabase) DB makes every extra
  // round trip cost ~150ms, so nested includes must not fan out.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(uuid())
  // 6-digit human-facing id admins use to look up and filter accounts.
  publicId     String  @unique
  // Phone number is the primary identifier; email is optional extra contact.
  phone        String  @unique
  email        String? @unique
  passwordHash String
  name         String?
  role         Role    @default(USER)
  avatarUrl    String?

  // Account stays unusable until the email/phone is confirmed via OTP.
  verified Boolean @default(false)

  watchHistory  WatchHistory[]
  watchlist     Watchlist[]
  ratings       Rating[]
  subscriptions Subscription[]
  payments      Payment[]
  rentals       Rental[]
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicId])
}

/// Rotating refresh tokens — the raw token is only ever stored hashed, so a
/// database leak can't be replayed. Revoking a row (or deleting the user)
/// invalidates the session server-side, which a stateless JWT can't do.
model RefreshToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum PhoneVerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
}

// What a verified verify.mn session authorizes: confirming a new account, or
// proving phone ownership before a password reset.
enum PhoneVerifyPurpose {
  VERIFY
  RESET
}

/// A verify.mn Mobile-Originated (MO) SMS verification session: the *user*
/// texts a per-session code to shortcode 144773; verify.mn confirms receipt and
/// we poll (or get a callback) until VERIFIED. One row per verify.mn session,
/// keyed by its sessionId. This replaces the old send-a-code SMS OTP flow.
model PhoneVerification {
  id        String @id @default(uuid())
  // verify.mn session id — the handle we poll and that the callback carries.
  sessionId String @unique
  phone     String
  // The 4-6 digit numeric code the user must SMS; unique per session, never
  // reused. Stored in clear only for support/debugging — it is not a secret
  // (verify.mn, not us, matches the inbound SMS against it).
  code    String
  status  PhoneVerificationStatus @default(PENDING)
  purpose PhoneVerifyPurpose      @default(VERIFY)
  // Id of the user this verification belongs to (null during registration if
  // the account is created after verification; here it is set at register).
  userId String?

  verifiedAt DateTime?
  // Set when the verified session is spent (e.g. a reset password applied), so
  // a one-time action can't be replayed.
  consumedAt DateTime?
  // verify.mn TTL (~300s). Past this without VERIFIED = failure.
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([phone])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog: movies, series, episodes
// ---------------------------------------------------------------------------

model Content {
  id          String        @id @default(uuid())
  title       String
  // Original (foreign) title shown next to the localized one.
  originalTitle String?
  slug        String        @unique
  description String?
  type        ContentType
  status      ContentStatus @default(DRAFT)
  // Airing state shown on the detail page: releasing vs finished.
  releaseStatus ReleaseStatus @default(COMPLETED)

  releaseYear Int?
  durationSec Int?
  ageRating   String?
  language    String?
  country     String?
  director    String?

  // ---- Individual rental (one-time paid access) ----
  // A title can be inside the subscription, rentable, both, or neither.
  isRentable           Boolean @default(false)
  rentalPrice          Int? // MNT (₮); required when isRentable
  rentalDurationHours  Int     @default(48)
  subscriptionIncluded Boolean @default(true)

  posterUrl   String?
  backdropUrl String?
  trailerUrl  String?

  // Cast member names shown on the detail page.
  cast String[]
  // Shown in the landing/home hero carousel.
  featured Boolean @default(false)

  // NOVEL only: the first N chapters are readable without a subscription.
  freeChapterCount Int @default(0)

  genres       ContentGenre[]
  seasons      Season[]
  chapters     Chapter[]
  videoAssets  VideoAsset[]
  subtitles    Subtitle[]
  watchHistory WatchHistory[]
  watchlist    Watchlist[]
  ratings      Rating[]
  rentals      Rental[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([featured])
  @@index([releaseYear])
}

model Genre {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  contents ContentGenre[]
}

model ContentGenre {
  contentId String
  genreId   String

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  genre   Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([contentId, genreId])
  @@index([genreId])
}

model Season {
  id        String  @id @default(uuid())
  contentId String
  number    Int
  title     String?

  content  Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episodes Episode[]

  createdAt DateTime @default(now())

  @@unique([contentId, number])
}

model Episode {
  id          String  @id @default(uuid())
  seasonId    String
  number      Int
  title       String
  description String?
  durationSec Int?

  thumbnailUrl String?

  season       Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  videoAssets  VideoAsset[]
  subtitles    Subtitle[]
  watchHistory WatchHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, number])
}

// A playable file in R2 — either for a movie (contentId) or an episode.
model VideoAsset {
  id String @id @default(uuid())

  contentId String?
  episodeId String?

  quality VideoQuality
  url     String?
  r2Key   String?

  mimeType  String?
  sizeBytes BigInt?

  content Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([contentId])
  @@index([episodeId])
}

model Subtitle {
  id String @id @default(uuid())

  contentId String?
  episodeId String?

  language String
  label    String?
  url      String?
  r2Key    String?

  content Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([contentId])
  @@index([episodeId])
}

// A light-novel chapter. Body is plain text; paragraphs split on blank lines.
model Chapter {
  id        String @id @default(uuid())
  contentId String
  number    Int
  title     String
  body      String

  content      Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)
  watchHistory WatchHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contentId, number])
}

// ---------------------------------------------------------------------------
// User activity
// ---------------------------------------------------------------------------

model WatchHistory {
  id String @id @default(uuid())

  userId    String
  contentId String
  episodeId String?
  chapterId String?

  progressSec Int      @default(0)
  completed   Boolean  @default(false)
  watchedAt   DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, episodeId, chapterId])
  @@index([userId, watchedAt])
}

model Watchlist {
  id String @id @default(uuid())

  userId    String
  contentId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, contentId])
}

model Rating {
  id String @id @default(uuid())

  userId    String
  contentId String
  score     Int // 1–5, validated at the API layer
  review    String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, contentId])
  @@index([contentId])
}

// ---------------------------------------------------------------------------
// Billing: plans, subscriptions, payments
// ---------------------------------------------------------------------------

model Plan {
  id          String        @id @default(uuid())
  name        String
  price       Int // MNT (₮)
  durationDay Int
  quality     VideoQuality?
  maxDevices  Int           @default(1)
  // Inactive plans stay attached to old subscriptions but can't be purchased.
  active      Boolean       @default(true)

  subscriptions Subscription[]
  payments      Payment[]

  createdAt DateTime @default(now())
}

model Subscription {
  id String @id @default(uuid())

  userId String
  planId String

  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  endsAt    DateTime

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  createdAt DateTime @default(now())

  @@index([userId, endsAt])
  @@index([status])
}

model Payment {
  id String @id @default(uuid())

  userId String
  // The plan being purchased; the subscription is created when payment lands.
  planId         String?
  subscriptionId String?
  // Rental payments target a content instead of a plan.
  contentId String?

  amount Int // MNT (₮)
  method PaymentMethod
  status PaymentStatus @default(PENDING)

  // Provider references: QPay invoice_id for polling, payment_id on success.
  invoiceId     String?
  transactionId String?
  paidAt        DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan?         @relation(fields: [planId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  content      Content?      @relation(fields: [contentId], references: [id])
  rental       Rental?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([invoiceId])
}

// A paid one-time entitlement to a single title. Created only after the
// rental payment is verified; playback is allowed while endsAt is ahead.
model Rental {
  id String @id @default(uuid())

  userId    String
  contentId String
  paymentId String? @unique

  startsAt DateTime @default(now())
  endsAt   DateTime

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, endsAt])
  @@index([contentId])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum ContentType {
  MOVIE
  SERIES
  NOVEL
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Airing state of a title: still releasing new episodes vs finished.
enum ReleaseStatus {
  RELEASING
  COMPLETED
}

enum VideoQuality {
  P480
  P720
  P1080
  P4K
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  QPAY
  WIRE
  CARD
  BANK
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
